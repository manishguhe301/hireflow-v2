// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==================== USER MODEL ====================
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  password      String
  name          String
  role          Role      @default(JOB_SEEKER)
  emailVerified Boolean   @default(false)
  isActive Boolean        @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  profile       Profile?
  company       Company?
  applications  Application[]
  savedJobs     SavedJob[]
  notifications Notification[]
}

enum Role {
  JOB_SEEKER
  COMPANY_ADMIN
  PLATFORM_ADMIN
}

// ==================== PROFILE MODEL (Job Seeker) ====================
model Profile {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  userId               String   @unique @db.ObjectId
  photo                String?
  phone                String?
  country              String?
  city                 String?
  preferredWorkMode    WorkMode[]
  willingToRelocate    Boolean  @default(false)
  professionalTitle    String?
  bio                  String?
  yearsOfExperience    Int?
  currentEmployment    String?
  
  // Resume
  resumeUrl            String?
  resumeName           String?
  
  // Skills
  skills               String[]
  
  // Work Experience 
  workExperience       WorkExperience[]
  
  // Education 
  education            Education[]
  
  // Certifications 
  certifications       Certification[]
  
  // Links
  portfolioWebsite     String?
  githubUrl            String?
  linkedinUrl          String?
  twitterUrl           String?
  otherLinks           String[]
  
  // Preferences
  jobCategories        String[]
  preferredLocations   String[]
  expectedSalaryMin    Int?
  expectedSalaryMax    Int?
  noticePeriod         String?
  
  profileCompleted     Int       @default(0)
  isPublic             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkExperience {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId     String   @db.ObjectId

  company       String
  title         String
  location      String?
  workMode      WorkMode
  startDate     DateTime
  endDate       DateTime?
  description   String?
  isCurrent     Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Education {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId     String   @db.ObjectId

  institution   String
  degree        String
  fieldOfStudy  String?
  startYear     Int
  endYear       Int?
  grade         String?
  isCurrent     Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Certification {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId       String   @db.ObjectId

  name            String
  organization    String
  issueDate       DateTime?
  expiryDate      DateTime?
  credentialId    String?
  credentialUrl   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}


// ==================== COMPANY MODEL ====================
model Company {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  userId            String         @unique @db.ObjectId
  name              String
  logo              String?
  logoPath          String?        
  description       String
  industry          String
  companySize       String
  foundedYear       Int?
  website           String?
  linkedinProfile   String?

  country          String
  countryPhoneCode String?

  // Contact
  contactEmail      String
  contactPhone      String?
  address           String?
  
  // Documents
  businessDocument  String?
  businessDocPath   String?
  taxDocument       String?
  taxDocPath        String?
  
  // Status
  status            CompanyStatus  @default(PENDING)
  rejectionReason   String?

  // Approval
  approvedAt DateTime?
  approvedBy String? 

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==================== JOB MODEL ====================
model Job {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  companyId           String           @db.ObjectId
  title               String
  description         String
  requirements        String
  responsibilities    String?
  skills              String[]
  experienceLevel     ExperienceLevel
  employmentType      EmploymentType
  workMode            WorkMode
  country             String
  city                String?
  salaryMin           Int?
  salaryMax           Int?
  // currency            Currency?
  hideSalary          Boolean          @default(false)
  numberOfOpenings    Int              @default(1)
  applicationDeadline DateTime?
  category            String
  slug                String           @unique
  
  status              JobStatus        @default(ACTIVE)
  views               Int              @default(0)
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
  savedJobs    SavedJob[]
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkMode {
  REMOTE
  HYBRID
  ON_SITE
}

enum JobStatus {
  ACTIVE
  CLOSED
  DRAFT
}

enum Currency {
  INR  
  USD  
  EUR  
  GBP  
  AUD  
  CAD  
  SGD  
  AED  
}


// ==================== APPLICATION MODEL ====================
model Application {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  userId          String            @db.ObjectId
  jobId           String            @db.ObjectId
  resumeUrl       String
  coverLetter     String?
  status          ApplicationStatus @default(APPLIED)
  internalNotes   String?
  
  // Status timeline (JSON array of { status, date })
  statusHistory   Json?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  INTERVIEW_SCHEDULED
  REJECTED
  OFFERED
  HIRED
}

// ==================== SAVED JOB MODEL ====================
model SavedJob {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  jobId     String   @db.ObjectId
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

// ==================== NOTIFICATION MODEL ====================
model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_STATUS_CHANGED
  COMPANY_APPROVED
  COMPANY_REJECTED
  NEW_JOB_POSTED
  JOB_CLOSED
}