{
  "crons": [
    {
      "path": "/api/cron/daily-notifications",
      "schedule": "0 9 * * 1-6",
      "headers": {
        "x-cron-secret": "@cron_secret"
      }
    },
    {
      "path": "/api/cron/refresh-signed-urls",
      "schedule": "0 9 * * 0",
      "headers": {
        "x-cron-secret": "@cron_secret"
      }
    }
  ]
}